# Variables de Entorno - Gestor de Tareas
# ==========================================
# IMPORTANTE: Este es un archivo de ejemplo
# Copia este archivo como .env y completa con tus valores reales
# NUNCA subas el archivo .env real a Git (está en .gitignore)

# ===== CONFIGURACIÓN DE BASE DE DATOS =====
DATABASE_URL=jdbc:postgresql://localhost:5432/gestor_tareas
DB_USERNAME=tu_usuario
DB_PASSWORD=tu_contraseña_segura

# ===== CONFIGURACIÓN DEL SERVIDOR =====
PORT=8080
SPRING_PROFILES_ACTIVE=prod

# ===== CONFIGURACIÓN DE FRONTEND =====
# URL del frontend para CORS (tu aplicación React/Angular/Vue desplegada)
FRONTEND_URL=https://tu-frontend.vercel.app

# ===== CONFIGURACIÓN DE SEGURIDAD =====
# Clave secreta para JWT (si implementas autenticación con tokens)
JWT_SECRET=tu_clave_secreta_muy_larga_y_aleatoria_2024

# ===== CONFIGURACIÓN DE DOCKER HUB (para CI/CD) =====
DOCKER_USERNAME=tu_usuario_dockerhub
DOCKER_PASSWORD=tu_token_dockerhub

# ===== CONFIGURACIÓN DE RAILWAY/RENDER =====
# Railway y Render detectan automáticamente DATABASE_URL
# Solo necesitas configurar estas variables en su panel web

# ===== NOTAS IMPORTANTES =====
# 1. Genera contraseñas seguras: https://passwordsgenerator.net/
# 2. Para JWT_SECRET usa al menos 256 bits de aleatoriedad
# 3. Cambia TODOS los valores por defecto antes de producción
# 4. Revisa que .env esté en .gitignore
